# ===============================================================
# TENCYBER SSO Configuration (System B - OpsOne Platform)
# ===============================================================
# ได้รับจาก TENCYBER Admin หลังลงทะเบียน client
VITE_TENCYBER_CLIENT_ID=your-client-id-from-tencyber-admin

# Base URL ของ TENCYBER IdP (อย่าเปลี่ยนถ้าไม่แน่ใจ)
VITE_TENCYBER_URL=https://dashboard.tenfw.com

# Callback URL ที่ต้องแจ้ง TENCYBER Admin ให้ whitelist ไว้
# รูปแบบ: https://DOMAIN_ของ_OPSONE/auth/callback
VITE_REDIRECT_URI=http://localhost:5173/auth/callback

# Secret for signing secure preview links (set a long random string in production)
PREVIEW_SECRET=change-me-to-a-long-random-string

# ===============================================================
# Read-Only Inventory API (external integrations)
# ===============================================================
# API key for GET /api/v1/inventory/* — callers send it as
#   x-api-key: <key>      or      Authorization: Bearer <key>
# If this is unset the Inventory API stays DISABLED (returns 503).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INVENTORY_API_KEY=

# ===============================================================
# Database (never hardcode these in committed files)
# ===============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=opsone_db
DB_USER=opsone
DB_PASS=
